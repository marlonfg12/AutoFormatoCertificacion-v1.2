# =============================================================================
# CONFIGURACIÓN GENERAL DEL GENERADOR DE INFORMES QA
# =============================================================================

# Ruta base donde se guardarán los informes generados.
# Puede ser una carpeta local o una unidad compartida en la nube (Google Drive, OneDrive, etc.).
# Si se deja vacío o la ruta no está montada, se guardará en la carpeta local ./output
OUTPUT_PATH="./output"

# Prefijo del nombre del archivo .docx generado
# Ejemplo: REPORT_PREFIX="Resultado_Pruebas" -> genera "Resultado_Pruebas_12345_NombreHU.docx"
REPORT_PREFIX="Resultado_Pruebas"

# Ruta personalizada al archivo de plantilla Word (.docx).
# Si no se especifica, el sistema buscará "plantilla_resultado_pruebas.docx" o "template.docx" en la raíz del proyecto.
# TEMPLATE_PATH="./plantilla_resultado_pruebas.docx"

# =============================================================================
# METADATOS DEL INFORME WORD (PERSONALIZABLES POR EQUIPO / EMPRESA)
# =============================================================================
QA_REQUESTER="Líder Técnico de QA"
QA_MODULE="Módulo Web"
QA_TESTING_AREA="TECNOLOGÍA / ASEGURAMIENTO DE CALIDAD"
QA_ENVIRONMENT="QA Staging"
QA_TEST_STAGE="QA / Pruebas Funcionales"
QA_TEST_TYPE="Funcional / E2E"
DEFAULT_SPRINT="Sprint Actual"
QA_PROJECT_NAME="Proyecto Principal"
QA_OBSERVATIONS="Pruebas ejecutadas y validadas conforme a la definición de terminado."
